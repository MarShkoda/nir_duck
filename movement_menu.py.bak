import cv2
import enum
import math
import numpy as np
from scipy.linalg import solve_continuous_are
from scipy import stats

from pyglet.window import key
from gym_duckietown.envs import DuckietownEnv
from controllers.pid_controller import PIDController
from image_processing.line_processing import ImageLineProcessing
from image_processing.line_processing import ColorLine


env = DuckietownEnv(
	**{"seed": 128546,
	"map_name": "zigzag_dists", # где-то в репозитории можно эти карты настраивать
	"max_steps": 1000,
	"camera_width": 640,
	"camera_height": 480,
	"accept_start_angle_deg": 60, #what
	"full_transparency": True,
	"distortion": True,
	"domain_rand": False
	}
)

env2 = DuckietownEnv(
    **{"seed": 128546,
    "map_name": "straight_road", 
    "max_steps": 1000,
    "camera_width": 640,
    "camera_height": 480,
    "accept_start_angle_deg": 30, #what
    "full_transparency": True,
    "distortion": True,
    "domain_rand": False
    }
)

env3 = DuckietownEnv(
    **{"seed": 128546,
    "map_name": "loop_empty", 
    "max_steps": 10000,
    "camera_width": 640,
    "camera_height": 480,
    "accept_start_angle_deg": 40, #what
    "full_transparency": True,
    "distortion": True,
    "domain_rand": False
    }
)


done = False
obs = env.reset()
step = 0
paused = False

#pid_angular = PIDController(kp=0.2, ki=0.01, kd=0.005)
k_p = 2.3
pid_angular = PIDController(kp=1.38, ki=2.09, kd=0.23)
pid_angular2 = PIDController(kp=1.38, ki=2.09, kd=0.23)
dt = 0.033 #найден с помощью файла find_dt (задано в симуляторе) 1с/30кадр

def create_info_panel(info_text, width=300, height=480):
    panel = np.zeros((height, width, 3), dtype=np.uint8)
    panel.fill(240)
    
    y = 30
    for line in info_text.split('\n'):
        cv2.putText(panel, line, (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 0), 1)
        y += 20
    
    return panel

def moving_test(obs, step):
    img = np.ascontiguousarray(obs)
    height = 480
    width = 640
    
    yellow_image = ImageLineProcessing(img, width, height, ColorLine.yellow)
    white_image = ImageLineProcessing(img, width, height, ColorLine.white)
    yellow_angle = yellow_image.process()
    white_angle = white_image.process()
    
    cx1 = cx2 = cy1 = cy2 = 0
    if (cx1 == -1):
        cy1 = cy2
    
    if (cx2 == -1):
        cy2 = cy1
        
    cx = int((cx1+cx2)/2)
    cy = int((cy1+cy2)/2)
    
        
    ng = -((yellow_angle + white_angle)/2)
    
    moment_image = np.zeros((height, width, 3), np.uint8)
    cv2.circle(moment_image, (cx, cy), 5, (0,255,255), 5)
    cv2.imwrite("//home//userubuntu//gym-duckietown//rubbish//moment_image.png", moment_image)

    if np.isnan(yellow_angle):
        yellow_angle = math.pi
    if np.isnan(white_angle):
        white_angle = -math.pi
    
    
    res = pid_angular2.compute(ng, dt)
    
    info_text = f"Step: {step}\n"
    info_text += f"Yellow angle: {yellow_angle*180/math.pi:.2f}\n"
    info_text += f"White angle: {white_angle*180/math.pi:.2f}\n"
    info_text += f"Avg angle: {(yellow_angle + white_angle)*90/math.pi:.2f}\n"
    info_text += f"PID angle: {res:.2f}\n"
    info_text += "\nControls:\n"
    info_text += "P - Pause/Resume\n"
    info_text += "Q - Quit\n"
    
    yellow_mask = yellow_image.color_mask
    white_mask = white_image.color_mask
    yellow_region = yellow_image.region_selection()
    white_region = white_image.region_selection()
    
    debug_panel = np.zeros((height, width + 300, 3), dtype=np.uint8)
    
    debug_panel[:height, :width] = img
    
    

    
    # Информационная панель
    debug_panel[:height, width:width+300] = create_info_panel(info_text)
    
    try:
        moment = cv2.imread("//home//userubuntu//gym-duckietown//rubbish//moment_image.png", cv2.IMREAD_UNCHANGED)
        debug_panel[:height, :width] = cv2.addWeighted(debug_panel[:height, :width], 0.7, moment, 0.9, 0)

        # Для желтой линии
        yellow_overlay = cv2.imread("//home//userubuntu//gym-duckietown//rubbish//2approxColorLine.yellow.png", cv2.IMREAD_UNCHANGED)
        yellow_line = cv2.imread("//home//userubuntu//gym-duckietown//rubbish//lineColorLine.yellow.png", cv2.IMREAD_UNCHANGED)

        if yellow_overlay is not None:
            if yellow_overlay.shape[2] == 4:
                alpha = yellow_overlay[:,:,3] / 255.0
                for c in range(0, 3):
                    debug_panel[:height, :width, c] = (
                        debug_panel[:height, :width, c] * (1 - alpha) + 
                        yellow_overlay[:,:,c] * alpha
                        )
            else:
                debug_panel[:height, :width] = cv2.addWeighted(debug_panel[:height, :width], 0.7, yellow_overlay, 0.3, 0)
                debug_panel[:height, :width] = cv2.addWeighted(debug_panel[:height, :width], 0.7, yellow_line, 0.3, 0)
        
        white_overlay = cv2.imread("//home//userubuntu//gym-duckietown//rubbish//2approxColorLine.white.png", cv2.IMREAD_UNCHANGED)
        white_line = cv2.imread("//home//userubuntu//gym-duckietown//rubbish//lineColorLine.white.png", cv2.IMREAD_UNCHANGED)
        if white_overlay is not None:
            if white_overlay.shape[2] == 4:
                alpha = white_overlay[:,:,3] / 255.0
                for c in range(0, 3):
                    debug_panel[:height, :width, c] = (
                        debug_panel[:height, :width, c] * (1 - alpha) + 
                        white_overlay[:,:,c] * alpha
                    )
            else:
                debug_panel[:height, :width] = cv2.addWeighted(debug_panel[:height, :width], 0.7, white_overlay, 0.3, 0)
                debug_panel[:height, :width] = cv2.addWeighted(debug_panel[:height, :width], 0.7, white_line, 0.3, 0)
    except Exception as e:
        print(f"Ошибка при наложении изображений: {e}")
        
    cv2.imwrite("//home//userubuntu//gym-duckietown//rubbish//debug_panel.png", debug_panel)

    cv2.imshow("Debug Info", debug_panel)

    key = cv2.waitKey(1) & 0xFF
    global paused
    if key == ord('p'):
        paused = not paused
    elif key == ord('q'):
        global done
        done = True
    
    while paused:
        key = cv2.waitKey(1) & 0xFF
        if key == ord('p'):
            paused = not paused
        elif key == ord('q'):
            done = True
            break
    
    
    return (yellow_angle + white_angle)/2
with open("pid_49.txt", "w", encoding="utf-8") as f: 
    while not done:
        desired_angle = 0.0    # желаемый угол (в радианах)
        print('step ', step)
        current_angle = moving_test(obs, step) # угол отклонения от направления движения (в радианах)
        step += 1
        angular_error = desired_angle - current_angle
        angular_control = pid_angular.compute(angular_error, dt)
        info_text = f"{step}, {current_angle:.2f}, {angular_control:.2f}\n"
        f.write(info_text)
        #print('angular_control ', angular_control)
        #print('angular_error ', angular_error)
        
        # Управляющие скорости
        linear_speed = 0.6
        angular_speed = -angular_control # коррекция угловой скорости

        action = [linear_speed, angular_speed]
        obs, rew, done, info = env.step(np.array(action))
        env.render()

cv2.destroyAllWindows()