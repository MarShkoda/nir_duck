import cv2, math, numpy as np
from gym_duckietown.envs import DuckietownEnv
from controllers.pid_controller import PIDController

# ——— LaneKeepingAlgorithm‑V2 адаптация ———
class LaneKeepingV2:
    def __init__(self):
        self.kalman = cv2.KalmanFilter(2,1)
        self.kalman.transitionMatrix = np.array([[1,1],[0,1]], np.float32)
        self.kalman.measurementMatrix = np.array([[1,0]], np.float32)
        self.kalman.processNoiseCov = np.eye(2, dtype=np.float32) * 0.03
        self.kalman.measurementNoiseCov = np.array([[0.5]], np.float32)

    def detect(self, frame):
        h, w = frame.shape[:2]
        # динамический ROI
        roi = frame[int(h*0.5):h, :]
        gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
        blur = cv2.GaussianBlur(gray, (5,5),0)
        edges = cv2.Canny(blur,50,150)
        # Hough + RANSAC
        lines = cv2.HoughLinesP(edges,1,np.pi/180,50,minLineLength=50,maxLineGap=150)
        if lines is None:
            return None, frame
        # фильтрация и RANSAC (упрощённо)
        pts = []
        for l in lines:
            x1,y1,x2,y2 = l[0]
            pts.append([x1,y1])
            pts.append([x2,y2])
        pts = np.array(pts)
        [vx,vy, x0,y0] = cv2.fitLine(pts, cv2.DIST_L2,0,0.01,0.01)
        # вычисление угла
        angle = math.degrees(math.atan2(vy, vx))
        # сглаживаем Калманом
        pred = self.kalman.predict()
        meas = np.array([[np.float32(angle)]])
        self.kalman.correct(meas)
        smooth_angle = float(self.kalman.statePost[0])
        # визуализация линии
        pt1 = (int(x0 - vx*w), int(y0 - vy*w + h*0.5))
        pt2 = (int(x0 + vx*w), int(y0 + vy*w + h*0.5))
        vis = frame.copy()
        cv2.line(vis, pt1, pt2, (0,255,0), 3)
        return smooth_angle, vis

# ——— Основной скрипт ———
env = DuckietownEnv(
    seed=1, map_name="zigzag_dists", max_steps=1000,
    camera_width=640, camera_height=480,
    full_transparency=True, distortion=True, domain_rand=False
)
obs = env.reset()
lk = LaneKeepingV2()
pid = PIDController(kp=0.35, ki=0.02, kd=0.009)
dt = 0.05
done=False

while not done:
    frame = np.ascontiguousarray(obs)
    angle, vis = lk.detect(frame)
    if angle is None:
        angle = 0.0  # fallback
    error = -math.radians(angle)
    ctrl = pid.compute(error, dt)
    action = [0.6, -ctrl*5]
    obs, reward, done, info = env.step(np.array(action))
    env.render()
    cv2.imshow("LK V2 Visualization", vis)
    if cv2.waitKey(1)&0xFF==ord('q'): break

cv2.destroyAllWindows()
